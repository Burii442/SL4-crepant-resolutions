LIB "elim.lib";option(noredefine);option(redSB);ring R=0,(p,r,s,t,w,y0,y2,v),dp;short=0;
ideal raw=-108*p^(5)*s - 16*p^(4)*r^(3) + 72*p^(4)*r*s*t + 4*p^(3)*r^(2)*s*t^(2) + 900*p^(3)*r*s - 16*p^(3)*s^(2)*t^(3) + 128*p^(2)*r^(4) - 560*p^(2)*r^(2)*s*t - 825*p^(2)*s^(2)*t^(2) - 144*p*r^(3)*s*t^(2) - 2000*p*r^(2)*s + 630*p*r*s^(2)*t^(3) + 3750*p*s^(2)*t - 256*r^(5) + 1600*r^(3)*s*t + 27*r^(2)*s^(2)*t^(4) - 2250*r*s^(2)*t^(2) - 108*s^(3)*t^(5) - 3125*s^(2) + w^(2),-v*y0 + w,45*p^(2) - 32*p*r*t - 100*r + 9*s*t^(3) - v,-32*p*r^(2) + 15*p*s*t + 9*r*s*t^(2) - 375*s - v*y2;print("SAT_START");ideal C=std(sat(raw,ideal(v*(8*p*t+25))));ideal rawDD=C+ideal(w,-32*p^(5) + 308*p^(3)*r - 216*p^(2)*s*t^(2) - 720*p*r^(2) + 135*r*s*t^(2) + 625*s,-4*p^(4) + 36*p^(2)*r - 27*p*s*t^(2) - 80*r^(2) + 50*s*t,-16*p^(6) + 224*p^(4)*r - 88*p^(3)*s*t^(2) - 1040*p^(2)*r^(2) + 360*p*r*s*t^(2) + 1600*r^(3) + 135*s^(2)*t^(4),4*p^(3)*s*t^(2) - 40*p^(2)*s*t - 36*p*r*s*t^(2) + 200*r*s*t + 27*s^(2)*t^(4),4*p^(3)*s*t - 40*p^(2)*s - 36*p*r*s*t + 200*r*s + 27*s^(2)*t^(3));print("DD_START");ideal center=std(sat(rawDD,ideal(v*s*(8*p*t+25))));print("DD_CENTER_BEGIN");center;print("DD_CENTER_END");print("DIM");dim(center);print("DONE");quit;
